# Copy to .env and adjust. Never commit the real file.
# Which configuration to use: dev, demo, prod or test.
APP_CONFIG=demo
# Required with APP_CONFIG=prod: a random value of 32+ characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# prod only: how many reverse proxies sit in front of the app (default 1).
# PROXY_HOPS=1
